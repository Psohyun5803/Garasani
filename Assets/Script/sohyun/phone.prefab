--- !u!114 &2024905944052868301
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1960831608972379422}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC61B\uB0A0\uC5D0 \uB2F9\uACE0\uAC1C\uC5D0 \uC810\uBCF4\uB7EC \uAC04
    \uC801 \uC788\uC5C8\uB294\uB370  \n\n\uC5C4\uB9C8\uAC00 \uC790\uAFB8 \uAC00\uC704
    \uB20C\uB824\uC11C \uC5C4\uB9C8\uAC00 \uBCF4\uACE0 \uC654\uC74C. \uADFC\uB370
    \uCC98\uC74C \uAC14\uC744 \uB54C \uBB34\uB2F9\uC774 \uC9D1\uC5D0 \uC788\uB294
    \uC0AC\uB78C\uB4E4 \uB2E4 \uC640\uC57C \uD55C\uB2E4\uACE0 \uB2E4\uC2DC \uC624\uB77C\uB294
    \uAC70\uC57C. \uC9C0\uAE08 \uC544\uBE60 \uCD9C\uC7A5 \uAC00 \uC788\uACE0 \uB098
    \uC678\uB3D9\uC774\uB77C\uC11C \uC5C4\uB9C8\uB791 \uB098\uB791 \uB458\uC774 \uB2E4\uC2DC
    \uC654\uAC70\uB4E0? \uADFC\uB370 \uC65C \uB2E4 \uC548 \uB370\uB9AC\uACE0 \uC654\uB0D0\uACE0
    \uD654\uB0B4\uB294 \uAC70... \uADF8\uB798\uC11C \uC544\uBE60 \uCD9C\uC7A5 \uAC14\uB2E4\uACE0
    \uC598\uAE30\uD588\uB354\uB2C8 \uC544\uB2C8 \uC544\uBE60 \uB9D0\uACE0 \uB538
    \uC9D1\uC5D0 \uB194\uB450\uACE0 \uC654\uB2E4\uACE0 \uAC54\uB3C4 \uB370\uB9AC\uACE0
    \uC624\uB77C\uB294 \uAC70\uC57C. \uB09C \uADF8\uB798\uC11C \uCC98\uC74C\uC5D0
    \uB098 \uBAB0\uB798 \uC228\uACA8\uB454 \uC5B8\uB2C8\uB098 \uB3D9\uC0DD\uC774
    \uC788\uB294 \uAC74\uAC00...? \uB0B4\uAC00 \uD0DC\uC5B4\uB098\uAE30 \uC804\uC5D0
    \uC8FD\uC740 \uC5B8\uB2C8\uAC00 \uC788\uB098? \uC774\uB7F0 \uC624\uB9CC\uAC00\uC9C0
    \uC0DD\uAC01\uC744 \uB2E4\uD588\uB294\uB370 (\uBCF8\uC778 n\uC784)  \uC9D1\uC5D0
    \uB098\uC778\uCC99 \uD558\uB294 \uBB50\uAC00 \uC788\uB2E4\uB354\uB77C. \uADF8\uAC8C
    \uC790\uAFB8 \uC5C4\uB9C8 \uC798 \uB54C (\uB098\uB791 \uC5C4\uB9C8\uB791 \uC6D0\uB798
    \uB530\uB85C \uC7A0) \uBAA9\uC744 \uB204\uB974\uACE0 \uC788\uB2E4\uACE0. \uC548\uADF8\uB798\uB3C4
    \uC5C4\uB9C8 \uC6D0\uB798 \uAC00\uC704 \uB20C\uB9AC\uBA74 \uC774\uC0C1\uD55C
    \uBAA9\uC18C\uB9AC \uB0B4\uB294\uB370 \uC694\uC998 \uC774\uC0C1\uD558\uAC8C \uCEE5\uCEE5
    \uC18C\uB9AC\uB9CC \uB0B4\uC2DC\uB294 \uAC70\uC784. \uC5CA\uADF8\uC81C \uADF8\uB798\uC11C
    \uBD80\uC801 \uBA87\uAC1C \uC9C0\uC5B4\uC654\uB354\uB2C8 \uC774\uC81C \uAC00\uC704
    \uC548 \uB20C\uB9AC\uC154\u3160\u3160 \uC0AC\uC2E4 \uC5C4\uB9C8 \uB9D0\uACE0
    \uB098\uB791 \uC544\uBE60\uB294 \uAC00\uC704 \uD55C\uBC88\uB3C4 \uC548 \uB20C\uB824\uBD10\uC11C
    \uC9C4\uC9DC \uADC0\uC2E0 \uAC19\uC740\uAC8C \uC788\uB294 \uAC74\uAC00 \uC2F6\uACE0...
    \u3148\u3134\uBB34\uC12D\uB2E4  "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 43d0f75ad1a815f4e9aa316a41264bb5, type: 2}
